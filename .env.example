# Copy to .env for local overrides, or set these in your hosting platform's
# environment variable settings (e.g. Render dashboard).

# Turso (libSQL) database. Leave both unset to use a local SQLite file instead
# (fine for local development; not durable on most free hosting - use Turso there).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin login (single shared account for the /admin panel). Change both before
# deploying anywhere reachable from the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vigan-admin

# Set to 1 only when actually deployed behind a reverse proxy (Render, nginx, Caddy...)
# that sets X-Forwarded-For itself. Leave unset for local development.
TRUST_PROXY=

# Port to listen on. Most hosts (including Render) set this automatically.
PORT=3000
